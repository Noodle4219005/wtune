&time_control
 run_days=0, run_hours=6, run_minutes=0, run_seconds=30,
 start_year=2020, 2020, start_month=01, 01, start_day=01, 01, start_hour=00, 00,
 start_minute=00, 00, start_second=00, 00,
 end_year=2020, 2020, end_month=01, 01, end_day=01, 01, end_hour=06, 06,
 interval_seconds=21600,
 input_from_file=.true., .true.,
 history_interval_s=3600, 3600, frames_per_outfile=1, 1,
 restart=.false., restart_interval=360, override_restart_timers=.false.,
 io_form_history=2, io_form_restart=2, io_form_input=2, io_form_boundary=2,
 auxinput4_inname="wrflowinp_d<domain>", auxinput4_interval=360, 360, io_form_auxinput4=2,
 auxinput5_inname='wrfchemi_d<domain>_<date>', io_form_auxinput5=2,
 iofields_filename="iofields_d01.txt", "iofields_d02.txt", ignore_iofields_warning=.true.,
 ! io_form_input=11,
 nwp_diagnostics=1,
/
&domains
 time_step=60, max_dom=2, nproc_x=4, nproc_y=18, numtiles=2,
 numtiles_x=1,
 tile_sz_x=0,
 e_we=170, 244, e_sn=130, 175, e_vert=55, 55,
 dx=12000, 4000, dy=12000, 4000,
 parent_time_step_ratio=1, 3,
/
&physics
 mp_physics=8, 8, ra_lw_physics=4, 4, ra_sw_physics=4, 4, radt=12, 12,
 sf_sfclay_physics=1, 1, sf_surface_physics=2, 2, bl_pbl_physics=1, 1, bldt=0, 0,
 cu_physics=1, 0, cudt=0, 0, sst_update=1, hailcast_opt=0, 1,
 bl_mynn_tkebudget=0, 0,
 opt_run=3,
/
&fdda
 grid_fdda=1, 0, gfdda_inname="wrffdda_d<domain>", gfdda_interval_m=360, 360, io_form_gfdda=2,
 grid_sfdda=0, 1,
/
&dynamics
 hybrid_opt=2, w_damping=1, time_step_sound=4, 4, moist_adv_opt=1, 1, scalar_adv_opt=1, 1,
/
&bdy_control
 spec_bdy_width=5, specified=.true., .false., nested=.false., .true.,
/
&namelist_quilt
 nio_tasks_per_group=2, nio_groups=1,
/
&namelist_adios2
 adios2_numaggregators=4,
/
