# PLOV production environment, measured on f1/NCHC, 4 nodes x 56 ranks x 2 threads,
# WRF intel-adios2-dmsm tree, CONUS-type 1500x1500 case (jobs 1070403..1070876).
# Source these lines in the sbatch before `srun ... --distribution=cyclic`.
#
# OpenMP: KMP_BLOCKTIME=0 alone is -2.8% on 224x2 (default 200 ms spin steals the co-thread's core)
export OMP_NUM_THREADS=2 OMP_STACKSIZE=512M OMP_PROC_BIND=false KMP_BLOCKTIME=0
export I_MPI_PMI_LIBRARY=/usr/lib64/libpmi2.so
#
# Per-phase staging: micro attempts by default; the other phases are refusal-only until implemented.
export WTIMER_STAGE_MICRO=1 WTIMER_STAGE_RAD=0 WTIMER_STAGE_CUMULUS=0 \
       WTIMER_STAGE_PBL=0 WTIMER_STAGE_SURFACE=0
export WTIMER_STAGE_GRID=1 WTIMER_STAGE_SLOT_MB=4 WTIMER_STAGE_GAIN=0.5 \
       WTIMER_STAGE_SHARE_TIMEOUT_MS=60000
#
# Microphysics staging + node-local work stealing ("adapt75": chunks=6, cap 75% of NJ)
export WTIMER_STAGE_ROWS=4 WTIMER_STAGE_SHARE=1 WTIMER_STAGE_ADAPT=1 \
       WTIMER_STAGE_CHUNKS=6 WTIMER_STAGE_MAX_PCT=75
#
# Radiation staging + node-local row stealing ("rad4 rhs"): net -0.6% over 400 steps,
# bit-identical. OPTIONAL until the user rules on adopting it; leave commented to run Ec only.
# export WTIMER_RAD_ROWS=4 WTIMER_RAD_BUF=1 WTIMER_RAD_ISPLIT=32 WTIMER_RAD_FULLJ=0 WTIMER_RAD_SHARE=1
#
# Per-rank timer CSV output directory (set per arm; the wrappers append wtimer.<rank>.csv)
# export WTIMER_DIR=/path/to/run/dir WTIMER_DEBUG_RANK=0
#
# srun line (cyclic placement alone is -2.2% and is part of the measured -7.7%/-13%):
#   srun --mpi=pmi2 --distribution=cyclic -n 224 --ntasks-per-node=56 -c 2 ./wrf_wtimer.exe
