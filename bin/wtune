#!/usr/bin/env bash
# bin/wtune -- launches wtune.py under the envs/wtune pixi environment (python 3.11 + numpy,
# netCDF4, catboost, scikit-learn, cfgrib... -- see envs/wtune/pixi.toml), never under a bare
# system python3. scc's /usr/bin/python3 has none of numpy/catboost/sklearn, so the CatBoost
# proposer (predictor/decomp_search.py) never ran there under a bare-python invocation; this is
# the fix, not a change to wtune.py itself. See campaign/configs.py's module docstring (2026-09-24
# update) for the wider "supported interpreter" note.
set -euo pipefail

_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="$(cd "$_here/.." && pwd)"
manifest="$repo/envs/wtune/pixi.toml"

pixi_bin=""
if command -v pixi >/dev/null 2>&1; then
  pixi_bin="pixi"
elif [ -x "$HOME/.pixi/bin/pixi" ]; then
  pixi_bin="$HOME/.pixi/bin/pixi"
fi

if [ -z "$pixi_bin" ]; then
  echo "bin/wtune: pixi not found on PATH or at \$HOME/.pixi/bin/pixi -- install pixi first " \
       "(see envs/wtune/pixi.toml)" >&2
  exit 1
fi

exec "$pixi_bin" run --manifest-path "$manifest" python "$repo/wtune.py" "$@"
